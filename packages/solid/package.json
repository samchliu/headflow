{
  "name": "@headflow/solid",
  "version": "0.1.3",
  "description": "SolidJS adapter for HeadFlow",
  "keywords": [
    "node-graph",
    "flow",
    "headless",
    "solidjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchliu/headflow.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/samchliu/headflow/tree/main/packages/solid",
  "bugs": {
    "url": "https://github.com/samchliu/headflow/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@headflow/core": "workspace:*",
    "solid-js": "^1.8.17"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^24.1.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^1.6.0"
  }
}
