{
  "name": "@headflow/renderer",
  "version": "0.2.0",
  "description": "Framework-agnostic renderer math utilities for HeadFlow",
  "keywords": [
    "headflow",
    "renderer",
    "bezier",
    "lasso",
    "utility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchliu/headflow.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/samchliu/headflow/tree/main/packages/renderer",
  "bugs": {
    "url": "https://github.com/samchliu/headflow/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@headflow/core": ">=0.1.2"
  },
  "devDependencies": {
    "@headflow/core": "workspace:*",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
