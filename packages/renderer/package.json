{
  "name": "@headflow/renderer",
  "version": "0.1.0",
  "description": "Framework-agnostic renderer math utilities for HeadFlow",
  "keywords": ["headflow", "renderer", "bezier", "lasso", "utility"],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@headflow/core": "^0.1.0"
  },
  "devDependencies": {
    "@headflow/core": "workspace:*",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
