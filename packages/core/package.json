{
  "name": "@headflow/core",
  "version": "0.1.0",
  "description": "Headless node graph interaction engine — framework agnostic",
  "keywords": ["node-graph", "flow", "headless", "canvas", "diagram"],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
