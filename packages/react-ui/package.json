{
  "name": "@headflow/react-ui",
  "version": "0.3.0",
  "description": "Pre-built React components for HeadFlow — styled, composable, themeable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchliu/headflow.git",
    "directory": "packages/react-ui"
  },
  "homepage": "https://github.com/samchliu/headflow/tree/main/packages/react-ui",
  "bugs": {
    "url": "https://github.com/samchliu/headflow/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@headflow/core": "workspace:*",
    "@headflow/react": "workspace:*",
    "@headflow/renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1"
  }
}
